{
  "expo": {
    "name": "ROOST",
    "slug": "paultry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "paultry",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5B700",
        "foregroundImage": "./assets/brand/android-foreground.png",
        "monochromeImage": "./assets/brand/android-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.roost.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1E3F",
          "image": "./assets/brand/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "ROOST uses the camera for flock photos, symptom photos and receipts.",
          "photosPermission": "ROOST adds photos you choose to your flock journal."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/android-monochrome.png",
          "color": "#F5B700",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf659b84-138e-4d2b-8b6a-2993d885fda0"
      }
    },
    "owner": "jontembayas-team",
    "backgroundColor": "#0B1E3F"
  }
}
